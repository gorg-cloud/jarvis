# ─────────────────────────────────────────────────────────────
# JARVIS — configuration template
# Copy to `.env` and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── AI PROVIDERS ─────────────────────────────────────────────
# OpenRouter API key(s). Multiple keys = automatic failover:
#   GEMINI_API_KEY="key1,key2,key3"   (comma-separated)
#   GEMINI_API_KEY_2="key4"           (or numbered variants)
# When one key hits quota/rate-limit/auth errors it is
# quarantined and the next key is tried automatically.
GEMINI_API_KEY=
GEMINI_MODEL=nemotron-3-nano-30b-a3b:free

# Local fallback — used when cloud keys are exhausted or down
# (requires Ollama running locally: https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ornith:latest
OLLAMA_VISION_MODEL=gemma4:12b
OLLAMA_ENABLED=true
OLLAMA_FIRST=false

# Optional alternative cloud provider
ANTHROPIC_API_KEY=

# ── VOICE (text-to-speech) ───────────────────────────────────
# piper (local neural, most natural) | say (macOS built-in) | elevenlabs
TTS_ENGINE=piper
PIPER_BIN=
PIPER_MODEL=~/.jarvis/piper/en_GB-alan-medium.onnx
SAY_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── SPEECH-TO-TEXT ───────────────────────────────────────────
STT_ENGINE=google
WHISPER_MODEL=base

# ── INTEGRATIONS ─────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=
OBSIDIAN_VAULT=              # optional: vault name override
OBSIDIAN_VAULT_PATH=         # optional: direct vault path

# ── SYSTEM ───────────────────────────────────────────────────
JARVIS_MODE=                 # once | conversational
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
